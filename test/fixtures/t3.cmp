          IDENT  PPT,100B
          PERIPH
*         PP PROGRAM: DISPLAYS A TEXT ON THE CONSOLE.
 CH       EQU    10B         CONSOLE CHANNEL
 T1       EQU    1
          ORG    100B
 START    LDN    0
          STD    T1
 LOOP     FNC    7000B,CH    LEFT SCREEN, SMALL CHARACTERS
          ACN    CH
          LDN    MSGL
          OAM    MSG,CH
          DCN    CH
          AOD    T1
          SBN    5
          NJN    LOOP
          LJM    START
 MSG      CON    6100B,7600B
          DIS    ,*HELLO*
 MSGL     EQU    *-MSG
          UJN    *
          SHN    6
          SHN    -6
          LDC    123456B
          LDM    MSG,T1
          CRD    T1
          CRM    MSG,T1
          END
