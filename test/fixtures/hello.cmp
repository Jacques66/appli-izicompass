          IDENT  HELLO
          ENTRY  HELLO
*         WRITES TWO LINES ON OUTPUT AND A MESSAGE TO THE DAYFILE.
 HELLO    MESSAGE MSG
          WRITEC OUTPUT,LINE1
          SX1    12345
          CDD
          SA6    NUM
          WRITEC OUTPUT,LINE2
          WRITER OUTPUT
          ENDRUN
 MSG      DIS    ,*HELLO FROM THE 6600*
 LINE1    DIS    ,* FIRST LINE*
 LINE2    DIS    1,  NUMBER =
 NUM      DATA   0
          DATA   0
 OUTPUT   FILEC  BUF,BUFL
 BUFL     EQU    101B
 BUF      BSS    BUFL
          END    HELLO
