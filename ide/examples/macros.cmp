          IDENT  MACROS,100B,START
          ABS
          ORG    100B
*         MACRO ASSEMBLER DEMONSTRATION: MICROS, MACROS WITH A LOCAL
*         SYMBOL, CONDITIONAL ASSEMBLY (IFGE/ELSE/ENDIF), DUP AND
*         ECHO. ASSEMBLE (F7), THEN LOOK AT THE LISTING AND THE
*         SYMBOL TABLE.
*
*         A MICRO IS A STRING SUBSTITUTED WHEREVER "NAME" APPEARS.
*
VERSION   MICRO  1,,*V1.2*
SIZE      EQU    8           TABLE SIZE
*
*         MACRO WITH TWO PARAMETERS: STORES A VALUE IN MEMORY.
*
STORE     MACRO  VAL,ADDR
          SX6    VAL
          SA6    ADDR
          ENDM
*
*         MACRO WITH A LOCAL SYMBOL: COPIES N WORDS FROM SRC TO DST.
*         EACH CALL GETS ITS OWN LOOP LABEL.
*
MOVE      MACRO  SRC,DST,N
          LOCAL  LOOP
          SB7    N
LOOP      SB7    B7-1
          SA1    B7+SRC
          BX6    X1
          SA6    B7+DST
          NZ     B7,LOOP
          ENDM
*
START     STORE  5,FIVE
          STORE  SIZE*2,DOUBLE
          MOVE   SQUARES,COPY1,SIZE
          MOVE   NAMES,COPY2,3
*
*         CONDITIONAL ASSEMBLY ON THE VALUE OF SIZE.
*
          IFGE   SIZE,8
          SX6    1           LARGE TABLE
          ELSE
          SX6    0           SMALL TABLE
          ENDIF
          SA6    BIG
          PS
*
*         TABLE OF SQUARES 1, 4, 9, ... GENERATED BY DUP.
*
K         SET    0
SQUARES   BSS    0
          DUP    SIZE,2
K         SET    K+1
          CON    K*K
*
*         TABLE OF NAMES GENERATED BY ECHO (ONE ITERATION PER ITEM).
*
NAMES     BSS    0
          ECHO   ,N=(ALPHA,BETA,GAMMA)
          DATA   H*N*
          ENDD
*
BANNER    DIS    ,*COMPASS DEMONSTRATION "VERSION"*
FIVE      BSS    1
DOUBLE    BSS    1
BIG       BSS    1
COPY1     BSS    SIZE
COPY2     BSS    3
          END
