          IDENT  MACROS
          ENTRY  START
*         MACRO ASSEMBLER DEMONSTRATION: MICROS, MACROS WITH A LOCAL
*         SYMBOL, CONDITIONAL ASSEMBLY (IFGE/ELSE/ENDIF), DUP AND
*         ECHO. ASSEMBLE (F7), THEN LOOK AT THE LISTING AND THE
*         SYMBOL TABLE.
*
*         JOB UNDER THE MINI-SYSTEM (SYSTEM MODE): THE RESULTS ARE
*         PRINTED ON THE LINE PRINTER AND SENT TO THE DAYFILE AND THE
*         CONSOLE BY THE PRTNUM MACRO, ITSELF BUILT ON THE SYSTEXT
*         MACROS CDD, WRITEC AND MESSAGE.
*
*         A MICRO IS A STRING SUBSTITUTED WHEREVER "NAME" APPEARS.
*
VERSION   MICRO  1,,*V1.2*
SIZE      EQU    8           TABLE SIZE
*
*         MACRO WITH TWO PARAMETERS: STORES A VALUE IN MEMORY.
*
STORE     MACRO  VAL,ADDR
          SX6    VAL
          SA6    ADDR
          ENDM
*
*         MACRO WITH A LOCAL SYMBOL: COPIES N WORDS FROM SRC TO DST.
*         EACH CALL GETS ITS OWN LOOP LABEL.
*
MOVE      MACRO  SRC,DST,N
          LOCAL  LOOP
          SB7    N
LOOP      SB7    B7-1
          SA1    B7+SRC
          BX6    X1
          SA6    B7+DST
          NZ     B7,LOOP
          ENDM
*
*         MACRO THAT PRINTS THE NAME AND THE VALUE OF A WORD. THE
*         NAME OF THE WORD (FORMAL PARAMETER VAR) IS SUBSTITUTED IN
*         THE TEXT OF THE LINE. THE LINE IS GENERATED IN PLACE AND
*         JUMPED OVER.
*
PRTNUM    MACRO  VAR
          LOCAL  LINE,PAST
          SA1    VAR
          CDD                X6 = DECIMAL DIGITS
          SA6    LINE+1
          WRITEC OUTPUT,LINE
          MESSAGE LINE       DAYFILE AND CONSOLE
          EQ     PAST
LINE      DIS    1, VAR =
          BSSZ   1
          CON    0
PAST      BSS    0
          ENDM
*
START     STORE  5,FIVE
          STORE  SIZE*2,DOUBLE
          MOVE   SQUARES,COPY1,SIZE
          MOVE   NAMES,COPY2,3
*
*         CONDITIONAL ASSEMBLY ON THE VALUE OF SIZE.
*
          IFGE   SIZE,8
          SX6    1           LARGE TABLE
          ELSE
          SX6    0           SMALL TABLE
          ENDIF
          SA6    BIG
*
*         PRINT THE RESULTS.
*
          WRITEC OUTPUT,BANNER
          PRTNUM FIVE
          PRTNUM DOUBLE
          PRTNUM BIG
*
*         LINE OF THE COPIED SQUARES: ONE CDD CONVERSION PER WORD.
*
          SB1    1
          SB3    B0
          SB4    SIZE
SQLOOP    SA1    B3+COPY1
          CDD
          SA6    B3+SQNUM
          SB3    B3+B1
          LT     B3,B4,SQLOOP
          WRITEC OUTPUT,SQLINE
*
*         LINE OF THE COPIED NAMES: THE WORDS ARE ALREADY TEXT.
*
          WRITEC OUTPUT,NMLINE
          WRITER OUTPUT      WRITE THE BUFFER TO THE PRINTER
          ENDRUN
*
*         TABLE OF SQUARES 1, 4, 9, ... GENERATED BY DUP.
*
K         SET    0
SQUARES   BSS    0
          DUP    SIZE,2
K         SET    K+1
          CON    K*K
*
*         TABLE OF NAMES GENERATED BY ECHO (ONE ITERATION PER ITEM).
*
NAMES     BSS    0
          ECHO   ,N=(ALPHA,BETA,GAMMA)
          DATA   H*N*
          ENDD
*
BANNER    DIS    ,* COMPASS DEMONSTRATION "VERSION"*
SQLINE    DIS    1, SQUARES:
SQNUM     BSS    SIZE
          CON    0           END OF LINE
NMLINE    DIS    1, NAMES:
COPY2     BSS    3           COPY OF THE NAMES
          CON    0           END OF LINE
FIVE      BSS    1
DOUBLE    BSS    1
BIG       BSS    1
COPY1     BSS    SIZE
*
OUTPUT    FILEC  BUF,BUFL    FILE OUTPUT = LINE PRINTER
BUFL      EQU    101B
BUF       BSS    BUFL
          END    START
