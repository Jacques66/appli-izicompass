          IDENT  TEXTE,100B,DEBUT
          ABS
          ORG    100B
*         COMPTE LES LETTRES D UN MESSAGE ET LE RECOPIE DANS UN TAMPON.
*
*         LE TEXTE EST EN CODE DISPLAY : 6 BITS PAR CARACTERE, 10
*         CARACTERES PAR MOT (A = 01B, Z = 32B, 0 = 33B, BLANC = 55B).
*         ON EXTRAIT CHAQUE CARACTERE PAR ROTATION (LX) ET MASQUE (MX).
*
DEBUT     SB1    1           B1 = 1
          SB3    B0          B3 = INDICE DU MOT
          SX7    B0          X7 = NOMBRE DE LETTRES
          MX0    54          X0 = MASQUE DES 54 BITS HAUTS
MOT       SA1    B3+MESSAGE  X1 = MOT SUIVANT
          ZR     X1,FIN      MOT NUL : FIN DU MESSAGE
          BX6    X1
          SA6    B3+TAMPON   RECOPIE DU MOT
          SB4    10          10 CARACTERES PAR MOT
CAR       LX1    6           CARACTERE SUIVANT EN BAS
          BX2    -X0*X1      X2 = 6 BITS BAS DE X1
          SX3    X2-1        LETTRE SI 1 <= C <= 32B
          NG     X3,PAS
          SX3    X2-1R0      C - 33B
          PL     X3,PAS
          SX7    X7+1        UNE LETTRE DE PLUS
PAS       SB4    B4-B1
          NZ     B4,CAR
          SB3    B3+B1       MOT SUIVANT
          EQ     MOT
*
FIN       SA7    LETTRES     NOMBRE DE LETTRES
          SX6    B3
          SA6    MOTS        NOMBRE DE MOTS
          PS
*
MESSAGE   DIS    ,*BONJOUR DU CDC 6600, LE PREMIER SUPERORDINATEUR.*
          CON    0           MOT NUL DE FIN
LETTRES   BSS    1
MOTS      BSS    1
TAMPON    BSS    10
          END
