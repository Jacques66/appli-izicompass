          IDENT  CONSOLE,100B
          PERIPH
          ORG    100B
*         PP PROGRAM: DISPLAY ON THE 6612 CONSOLE AND KEYBOARD.
*
*         THE CONSOLE HAS NO IMAGE MEMORY: THE PP REDRAWS THE
*         SCREENS CONTINUOUSLY. FOR EACH SCREEN: FNC (SELECTS THE
*         SCREEN AND THE SIZE), ACN, OAM OF THE WORDS TO DISPLAY, DCN.
*         WORDS 60XX/61XX = X COORDINATE, 70XX/71XX = Y COORDINATE,
*         OTHER WORDS = TWO CHARACTERS IN DISPLAY CODE.
*         THE KEYBOARD IS READ BY FNC 7020B THEN IAN (0 = NO KEY).
*
*         TO RUN: AUTO OR PP MODE, THEN CLICK THE CONSOLE AND TYPE
*         SOME TEXT. ENTER CLEARS, BACKSPACE CORRECTS.
*
CH        EQU    10B         CONSOLE CHANNEL
LSMALL    EQU    7000B       LEFT SCREEN, SMALL CHARACTERS
LMED      EQU    7001B       LEFT SCREEN, MEDIUM CHARACTERS
RMED      EQU    7101B       RIGHT SCREEN, MEDIUM CHARACTERS
KEYBD     EQU    7020B       KEYBOARD INPUT
TCR       EQU    60B         CODE OF THE CR KEY
TBKSP     EQU    61B         CODE OF THE BKSP KEY
MAXW      EQU    16D         BUFFER CAPACITY (WORDS)
*
*         DIRECT CELLS (PP LOCATIONS 1 TO 77B)
*
T1        EQU    20B         KEY READ
NCHR      EQU    21B         NUMBER OF CHARACTERS ENTERED
NW        EQU    22B         NUMBER OF WORDS IN THE BUFFER
*
START     LDN    0           INITIALIZATION
          STD    NCHR
          STD    NW
*
*         SCREEN REFRESH LOOP
*
SHOW      FNC    LMED,CH     LEFT SCREEN, MEDIUM CHARACTERS
          ACN    CH
          LDN    BANNERL     NUMBER OF WORDS
          OAM    BANNER,CH
          DCN    CH
          FNC    LSMALL,CH   SMALL CHARACTERS
          ACN    CH
          LDC    HELPL
          OAM    HELP,CH
          DCN    CH
          FNC    RMED,CH     RIGHT SCREEN: TEXT ENTERED
          ACN    CH
          LDD    NW
          ADN    INBUF-HEADER+2 PLUS HEADER AND COORDINATES
          OAM    HEADER,CH
          DCN    CH
*
*         KEYBOARD INPUT
*
          FNC    KEYBD,CH
          ACN    CH
          IAN    CH          A = DISPLAY CODE OF THE KEY
          DCN    CH
          NJN    KEY         A KEY WAS PRESSED
          LJM    SHOW
*
KEY       STD    T1
          LMN    TCR
          ZJN    CLEAR       CR: CLEARS THE INPUT
          LDD    T1
          LMN    TBKSP
          ZJN    BACK        BKSP: ERASES ONE CHARACTER
          LDD    NCHR
          SBN    MAXW*2
          MJN    PLACE       ROOM LEFT
          LJM    SHOW        BUFFER FULL: KEY IGNORED
*
CLEAR     LDN    0
          STD    NCHR
          STD    NW
          LJM    SHOW
*
BACK      LDD    NCHR
          NJN    BACK1
          LJM    SHOW        NOTHING TO ERASE
BACK1     SOD    NCHR        A = NEW COUNT
          LPN    1
          NJN    HALF        ONE CHARACTER LEFT IN THE WORD
          SOD    NW          THE LAST WORD BECOMES EMPTY
          LJM    SHOW
HALF      LDM    INBUF+1,NW
          SCN    77B
          ADN    55B         REPLACES THE CHARACTER WITH A BLANK
          STM    INBUF+1,NW
          LJM    SHOW
*
PLACE     LDD    NCHR
          LPN    1           PARITY OF THE CHARACTER COUNT
          NJN    ODD         SECOND CHARACTER OF THE WORD
          LDD    T1          FIRST CHARACTER: NEW WORD
          SHN    6
          ADN    55B         PADDED WITH A BLANK
          STM    INBUF+2,NW
          AOD    NW
          UJN    COUNT
ODD       LDM    INBUF+1,NW  LAST WORD OF THE BUFFER
          SCN    77B         CLEARS THE BLANK
          LMD    T1          STORES THE CHARACTER
          STM    INBUF+1,NW
COUNT     AOD    NCHR
          LJM    SHOW
*
*         DISPLAYED TEXTS
*
BANNER    CON    6000B+100B,7000B+720B X = 100B, Y = 720B
          DIS    12,CDC 6600 - 6612 CONSOLE
BANNERL   EQU    *-BANNER
HELP      CON    6000B+40B,7000B+640B
          DIS    21,TYPE TEXT ON THE CONSOLE KEYBOARD:
          CON    6000B+40B,7000B+620B
          DIS    16,IT APPEARS ON THE RIGHT SCREEN.
          CON    6000B+40B,7000B+570B
          DIS    12,ENTER CLEARS THE INPUT,
          CON    6000B+40B,7000B+550B
          DIS    18,BACKSPACE ERASES ONE CHARACTER.
          CON    6000B+40B,7000B+100B
          DIS    23,THE PP REDRAWS BOTH SCREENS CONTINUOUSLY.
HELPL     EQU    *-HELP
HEADER    CON    6000B+40B,7000B+720B
          DIS    4,INPUT:
INBUF     CON    6000B+40B,7000B+660B
          BSS    MAXW
          END
