          IDENT  IMP,100B
          PERIPH
          ORG    100B
*         PROGRAMME PP : IMPRESSION SUR L IMPRIMANTE 1612 (CANAL 12B).
*
*         L IMPRIMANTE RECOIT UN CARACTERE BCD EXTERNE PAR MOT.
*         POUR CHAQUE LIGNE : FNC 600B (SELECTION), ACN, OAM DES
*         CARACTERES, DCN, PUIS FNC 605B QUI IMPRIME LA LIGNE.
*         LES TEXTES SONT EN CODE DISPLAY (2 CARACTERES PAR MOT) ET SONT
*         CONVERTIS EN BCD PAR LA TABLE BCD.
*         LE RESULTAT APPARAIT DANS L ONGLET PERIPHERIQUES > IMPRIMANTE.
*
CH        EQU    12B         CANAL LECTEUR/IMPRIMANTE
SELECT    EQU    600B        SELECTION DE L IMPRIMANTE
SAUT      EQU    604B        SAUT DE PAGE
IMPR      EQU    605B        IMPRESSION DE LA LIGNE
*
PT        EQU    20B         POINTEUR SUR LE TEXTE
NB        EQU    21B         NOMBRE DE CARACTERES
T1        EQU    22B
T2        EQU    23B
T3        EQU    24B
N         EQU    25B         NOMBRE COURANT
SQ        EQU    26B         SON CARRE
CPT       EQU    27B         COMPTEUR
*
DEBUT     FNC    SAUT,CH     NOUVELLE PAGE
          LDC    ENTETE
          STD    PT
          RJM    IMP         IMPRIME L EN-TETE
          LDC    VIDE
          STD    PT
          RJM    IMP         LIGNE BLANCHE
          LDN    1
          STD    N           N = 1
*
*         CARRE PAR ADDITIONS (LE PP N A PAS DE MULTIPLICATION)
*
BOUCLE    LDN    0
          STD    SQ
          LDD    N
          STD    CPT
CARRE     LDD    SQ
          ADD    N
          STD    SQ          SQ = SQ + N
          SOD    CPT
          NJN    CARRE
*
*         MISE EN FORME EN OCTAL DANS LA LIGNE MODELE
*
          LDD    N
          SHN    -6          DEUX CHIFFRES DE POIDS FORT
          RJM    OCT2
          STM    LNUM+2
          LDD    N
          LPN    77B         DEUX CHIFFRES DE POIDS FAIBLE
          RJM    OCT2
          STM    LNUM+3
          LDD    SQ
          SHN    -6
          RJM    OCT2
          STM    LNUM+10B
          LDD    SQ
          LPN    77B
          RJM    OCT2
          STM    LNUM+11B
          LDC    LNUM
          STD    PT
          RJM    IMP
          AOD    N           N = N + 1
          SBN    11D
          PJN    TERMINE     N > 10 : FIN
          LJM    BOUCLE
TERMINE   LDC    VIDE
          STD    PT
          RJM    IMP
          LDC    FINL
          STD    PT
          RJM    IMP
ARRET     UJN    *           FIN : LE PP BOUCLE SUR LUI-MEME
*
*         IMP : IMPRIME LE TEXTE D ADRESSE (PT), TERMINE PAR UN MOT NUL.
*         CONVENTION DE SOUS-PROGRAMME PP : RJM IMP RANGE L ADRESSE DE
*         RETOUR DANS LE MOT M DE L INSTRUCTION LJM QUI PRECEDE IMP.
*
IMPX      LJM    *           SORTIE
IMP       EQU    *-1         ENTREE
          LDN    0
          STD    NB
CONV      LDI    PT          MOT SUIVANT DU TEXTE
          SHN    -6          PREMIER CARACTERE
          ZJN    SORTIE      CARACTERE 00 : FIN DE LIGNE
          STD    T1
          LDM    BCD,T1      CONVERSION EN BCD EXTERNE
          STM    TAMP,NB
          AOD    NB
          LDI    PT
          LPN    77B         SECOND CARACTERE
          ZJN    SORTIE
          STD    T1
          LDM    BCD,T1
          STM    TAMP,NB
          AOD    NB
          AOD    PT
          UJN    CONV
SORTIE    FNC    SELECT,CH
          ACN    CH
          LDD    NB
          OAM    TAMP,CH     ENVOI DES CARACTERES
          DCN    CH
          FNC    IMPR,CH     IMPRESSION
          LJM    IMPX
*
*         OCT2 : A = 6 BITS -> A = DEUX CHIFFRES OCTAUX EN CODE DISPLAY
*
OCT2X     LJM    *
OCT2      EQU    *-1
          STD    T2
          LPN    7           CHIFFRE DE DROITE
          STD    T3
          LDD    T2
          LPN    70B         CHIFFRE DE GAUCHE
          SHN    3
          ADD    T3
          ADC    3333B       0 = 33B EN CODE DISPLAY
          LJM    OCT2X
*
*         TEXTES (CODE DISPLAY) ET TABLE DE CONVERSION DISPLAY -> BCD
*
ENTETE    DIS    ,*CDC 6600 - IMPRIMANTE 1612 - CARRES EN OCTAL*
VIDE      CON    0
LNUM      DIS    10,N = 0000  N*N = 0000
          CON    0
FINL      DIS    ,*FIN DE LA LISTE.*
BCD       CON    0B,61B,62B,63B,64B,65B,66B,67B 00-7
          CON    70B,71B,41B,42B,43B,44B,45B,46B 10-17
          CON    47B,50B,51B,22B,23B,24B,25B,26B 20-27
          CON    27B,30B,31B,12B,1B,2B,3B,4B 30-37
          CON    5B,6B,7B,10B,11B,60B,40B,54B 40-47
          CON    21B,34B,74B,53B,13B,20B,33B,73B 50-57
          CON    36B,17B,32B,16B,14B,35B,52B,37B 60-67
          CON    55B,56B,72B,57B,15B,75B,76B,77B 70-77
TAMP      BSS    136D        LIGNE A IMPRIMER
          END
