          IDENT  TRI,100B,DEBUT
          ABS
          ORG    100B
*         TRI PAR INSERTION D UNE TABLE D ENTIERS (ORDRE CROISSANT).
*
*         B1 = 1, B2 = I (ELEMENT A INSERER), B3 = J (POSITION).
*         LA COMPARAISON SE FAIT PAR SOUSTRACTION ENTIERE (IX) ET TEST
*         DU SIGNE (NG/PL).
*
DEBUT     SB1    1
          SB2    B1          I = 1
          SB4    NB          B4 = NOMBRE D ELEMENTS
SUIVANT   GE     B2,B4,FINI  I >= NB : TABLE TRIEE
          SA1    B2+TABLE    X1 = CLE = TABLE(I)
          SB3    B2          J = I
DECALE    ZR     B3,PLACE    J = 0 : DEBUT DE TABLE
          SA2    B3+TABLE-1  X2 = TABLE(J-1)
          IX3    X1-X2       CLE - TABLE(J-1)
          PL     X3,PLACE    CLE >= TABLE(J-1) : PLACE TROUVEE
          BX6    X2
          SA6    B3+TABLE    TABLE(J) = TABLE(J-1)
          SB3    B3-B1       J = J - 1
          EQ     DECALE
PLACE     BX6    X1
          SA6    B3+TABLE    TABLE(J) = CLE
          SB2    B2+B1       I = I + 1
          EQ     SUIVANT
FINI      PS
*
TABLE     CON    27,3,-14,1966,0,42,7,-1,600,64
NB        EQU    *-TABLE     NOMBRE D ELEMENTS
          END
