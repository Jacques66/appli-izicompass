          IDENT  HELLO
          ENTRY  HELLO
*         TRAVAIL SOUS LE MINI-SYSTEME (MODE SYSTEME).
*
*         LE PROGRAMME RELOGEABLE EST CHARGE EN RA+100B (RA = 2000B).
*         IL APPELLE LE SYSTEME PAR LES MACROS DU TEXTE SYSTEXT : MESSAGE
*         (JOURNAL), WRITEC (LIGNE SUR LE FICHIER OUTPUT = IMPRIMANTE),
*         CDD (CONVERSION DECIMALE) ET ENDRUN (FIN DU TRAVAIL).
*
*         APRES EXECUTION : ONGLETS JOURNAL ET PERIPHERIQUES > IMPRIMANTE.
*
*         ECRIT DEUX LIGNES SUR OUTPUT ET UN MESSAGE AU JOURNAL.
 HELLO    MESSAGE MSG
          WRITEC OUTPUT,LINE1
          SX1    12345
          CDD
          SA6    NUM
          WRITEC OUTPUT,LINE2
          WRITER OUTPUT
          ENDRUN
 MSG      DIS    ,*BONJOUR DU 6600*
 LINE1    DIS    ,* PREMIERE LIGNE*
 LINE2    DIS    1,  NOMBRE =
 NUM      DATA   0
          DATA   0
 OUTPUT   FILEC  BUF,BUFL
 BUFL     EQU    101B
 BUF      BSS    BUFL
          END    HELLO
