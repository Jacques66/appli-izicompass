          IDENT  SOMME,100B,DEBUT
          ABS
          ORG    100B
*         SOMME, SOMME DES CARRES ET FACTORIELLE DES ENTIERS 1 A N.
*
*         PROGRAMME CPU ABSOLU : CHARGE EN RA+100B, IL DEMARRE EN DEBUT
*         ET S ARRETE SUR L INSTRUCTION PS. LES RESULTATS SONT RANGES
*         EN SOMME, CARRES ET FACT (VOIR L ONGLET MEMOIRE).
*
N         EQU    10D         NOMBRE DE TERMES
*
DEBUT     SB1    1           B1 = 1 (CONSTANTE)
          SB2    N           B2 = I, DE N A 1
          SX6    B0          X6 = SOMME
          SX7    B0          X7 = SOMME DES CARRES
          SX5    B1          X5 = FACTORIELLE
BOUCLE    SX1    B2          X1 = I
          IX6    X6+X1       SOMME = SOMME + I
          IX2    X1*X1       I*I (PRODUIT ENTIER)
          IX7    X7+X2       CARRES = CARRES + I*I
          IX5    X5*X1       FACT = FACT * I
          SB2    B2-B1       I = I - 1
          NE     B2,B0,BOUCLE BOUCLE TANT QUE I NON NUL
*
          SA6    SOMME       RANGEMENT DES RESULTATS
          SA7    CARRES
          BX6    X5
          SA6    FACT
          PS                 ARRET DU PROGRAMME
*
SOMME     BSS    1           55 (67B)
CARRES    BSS    1           385 (601B)
FACT      BSS    1           3628800 (15657000B)
          END
