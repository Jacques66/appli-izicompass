          IDENT  HOR,100B
          PERIPH
          ORG    100B
*         PROGRAMME PP : HORLOGE TEMPS REEL ET TEXTE EXTERNE (XTEXT).
*
*         LE CANAL 14B EST RELIE A L HORLOGE : IL EST TOUJOURS ACTIF ET
*         PLEIN : IAN 14B RETOURNE LE TEMPS EN MICROSECONDES.
*         LE PP CUMULE LES ECARTS SUR 24 BITS ET AFFICHE LE RESULTAT EN
*         OCTAL EN GRANDS CARACTERES.
*         LES DEFINITIONS DE LA CONSOLE ET LA MACRO AFFICHE VIENNENT DU
*         TEXTE DEFS6612 (FICHIER DEFS6612.TXT DE L ESPACE DE TRAVAIL).
*
          XTEXT  DEFS6612
*
CHH       EQU    14B         CANAL DE L HORLOGE
AV        EQU    20B         DERNIERE VALEUR LUE
HI        EQU    21B         TEMPS CUMULE, 12 BITS HAUTS
LO        EQU    22B         TEMPS CUMULE, 12 BITS BAS
T1        EQU    23B
T2        EQU    24B
T3        EQU    25B
*
DEBUT     LDN    0
          STD    HI
          STD    LO
          IAN    CHH
          STD    AV
*
*         CUMUL DU TEMPS ECOULE DEPUIS LA LECTURE PRECEDENTE
*
BOUCLE    IAN    CHH         TEMPS COURANT
          STD    T1
          SBD    AV          ECART = T - AV
          LPC    7777B       MODULO 4096
          ADD    LO
          STD    LO          LO = LO + ECART (12 BITS)
          SHN    -12D        RETENUE
          RAD    HI          HI = HI + RETENUE
          LDD    T1
          STD    AV
*
*         MISE EN FORME : 8 CHIFFRES OCTAUX DANS LA LIGNE AFFICHEE
*
          LDD    HI
          SHN    -6
          RJM    OCT2
          STM    VALEUR
          LDD    HI
          LPN    77B
          RJM    OCT2
          STM    VALEUR+1
          LDD    LO
          SHN    -6
          RJM    OCT2
          STM    VALEUR+2
          LDD    LO
          LPN    77B
          RJM    OCT2
          STM    VALEUR+3
*
          AFFICHE ECRGM,TITRE,TITREL
          AFFICHE ECRGG,LIGNE,LIGNEL
          AFFICHE ECRDM,NOTE,NOTEL
          LJM    BOUCLE
*
*         OCT2 : A = 6 BITS -> A = DEUX CHIFFRES OCTAUX EN CODE DISPLAY
*
OCT2X     LJM    *
OCT2      EQU    *-1
          STD    T2
          LPN    7
          STD    T3
          LDD    T2
          LPN    70B
          SHN    3
          ADD    T3
          ADC    3333B
          LJM    OCT2X
*
TITRE     CON    COORX+20B,COORY+700B
          DIS    15,HORLOGE TEMPS REEL (CANAL 14B)
TITREL    EQU    *-TITRE
LIGNE     CON    COORX+200B,COORY+440B
VALEUR    BSS    4           8 CHIFFRES OCTAUX
LIGNEL    EQU    *-LIGNE
NOTE      CON    COORX+20B,COORY+500B
          DIS    7,MICROSECONDES
          CON    COORX+20B,COORY+440B
          DIS    8,SIMULEES (OCTAL)
NOTEL     EQU    *-NOTE
          END
