          IDENT  FLOT,100B,DEBUT
          ABS
          ORG    100B
*         CALCUL EN VIRGULE FLOTTANTE SUR LE CDC 6600.
*
*         1. RACINE CARREE DE 2 PAR LA METHODE DE NEWTON :
*         X(N+1) = (X(N) + A/X(N)) / 2
*         2. SOMME DE LA SERIE 1/K**2 POUR K = 100 A 1, QUI TEND
*         VERS PI**2/6 = 1.6449...
*
*         UN FLOTTANT 6600 : SIGNE, EXPOSANT DE 11 BITS ET COEFFICIENT
*         ENTIER DE 48 BITS (COMPLEMENT A UN).
*
DEBUT     SA1    VALEUR      X1 = A
          SA2    UN          X2 = X0 = 1.0
          SA3    DEMI        X3 = 0.5
          SB1    1
          SB2    6           6 ITERATIONS
NEWTON    RX4    X1/X2       A/X
          RX5    X2+X4       X + A/X
          NX5    X5          NORMALISATION
          RX2    X5*X3       X = (X + A/X) / 2
          SB2    B2-B1
          NZ     B2,NEWTON
          BX6    X2
          SA6    RACINE      RACINE = 1.41421356...
*
*         SERIE : ON SOMME A REBOURS (PETITS TERMES D ABORD).
*
          SA4    UN          X4 = 1.0
          BX6    X6-X6       X6 = 0 (SOMME)
          SB2    100D        K = 100
SERIE     SX1    B2          X1 = K (ENTIER)
          PX1    X1          CONVERSION ENTIER -> FLOTTANT
          NX1    X1
          RX2    X1*X1       K**2
          RX3    X4/X2       1/K**2
          RX6    X6+X3       SOMME = SOMME + 1/K**2
          NX6    X6
          SB2    B2-B1
          NZ     B2,SERIE
          SA6    ZETA2       ZETA2 = 1.63498...
          PS
*
VALEUR    DATA   2.0
UN        DATA   1.0
DEMI      DATA   0.5
RACINE    BSS    1
ZETA2     BSS    1
          END
