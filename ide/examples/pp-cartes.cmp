          IDENT  LEC,100B
          PERIPH
          ORG    100B
*         PROGRAMME PP : LECTURE DE CARTES SUR LE LECTEUR 405
*         (CANAL 12B) ET AFFICHAGE DES 64 PREMIERES COLONNES SUR LA
*         CONSOLE.
*
*         CHAQUE CARTE DONNE 80 MOTS DE 12 BITS : UNE COLONNE PAR MOT,
*         UN BIT PAR PERFORATION (BIT 11 = LIGNE 12, BIT 10 = LIGNE 11,
*         BIT 9 = LIGNE 0, BITS 8 A 0 = LIGNES 1 A 9). LE PP
*         CONVERTIT LE CODE HOLLERITH (029) EN CODE DISPLAY.
*         LECTURE : FNC 702B, ACN, IAM DE 80 MOTS ; LE CANAL SE
*         DECONNECTE SEUL EN FIN DE CARTE. SI LE MAGASIN EST VIDE,
*         A RESTE NON NUL.
*
*         AVANT DE LANCER : ONGLET PERIPHERIQUES > LECTEUR DE CARTES,
*         SAISIR UN PAQUET PUIS LE CHARGER DANS LE LECTEUR.
*
CH        EQU    12B         CANAL LECTEUR/IMPRIMANTE
LECT      EQU    702B        LECTURE D UNE CARTE
CHC       EQU    10B         CANAL DE LA CONSOLE
ECRG      EQU    7000B       ECRAN GAUCHE, PETITS CARACTERES
MAXC      EQU    24D         NOMBRE MAXIMAL DE CARTES AFFICHEES
LGL       EQU    34D         MOTS PAR LIGNE AFFICHEE (2 + 32)
*
NC        EQU    20B         NOMBRE DE CARTES LUES
PL        EQU    21B         POINTEUR DANS LA ZONE D AFFICHAGE
PC        EQU    22B         POINTEUR DANS LA CARTE
NM        EQU    23B         MOTS RESTANT A FORMER
V         EQU    24B         COLONNE A CONVERTIR
D         EQU    25B         LIGNES 1 A 9 DE LA COLONNE
NL        EQU    26B         NUMERO DE LIGNE DU CHIFFRE
Z         EQU    27B         ZONE (0, 12, 11, 0)
HUIT      EQU    30B         PERFORATION 8 COMBINEE
T1        EQU    31B
C1        EQU    32B         PREMIER CARACTERE DU MOT
Y         EQU    33B         COORDONNEE Y COURANTE
NT        EQU    34B         NOMBRE DE MOTS A AFFICHER
*
DEBUT     LDN    0
          STD    NC
          STD    NT
          LDC    ZONE
          STD    PL
          LDC    7000B+700B
          STD    Y
*
*         LECTURE D UNE CARTE
*
LIRE      LDD    NC
          SBN    MAXC
          MJN    LIRE1
          LJM    AFF         ZONE D AFFICHAGE PLEINE
LIRE1     FNC    LECT,CH
          ACN    CH
          LDC    80D         80 COLONNES
          IAM    CARTE,CH
          ZJN    LUE         CARTE COMPLETE
          LJM    AFF         MAGASIN VIDE : AFFICHAGE
LUE       LDM    CARTE       COLONNE 1
          SBN    17B         CARTE 6/7/8/9 OU 7/8/9 ?
          ZJN    FIN
          ADN    17B-7
          NJN    FORME
FIN       LJM    AFF         CARTE DE FIN : AFFICHAGE
*
*         FORMATION D UNE LIGNE : X, Y PUIS 32 MOTS DE DEUX CARACTERES
*
FORME     LDC    6000B+20B
          STI    PL          COORDONNEE X
          AOD    PL
          LDD    Y
          STI    PL          COORDONNEE Y
          AOD    PL
          LDD    Y
          SBN    14B         LIGNE SUIVANTE PLUS BAS
          STD    Y
          LDC    CARTE
          STD    PC
          LDN    32D
          STD    NM
MOT       LDI    PC
          STD    V
          RJM    HOLL        PREMIER CARACTERE
          SHN    6
          STD    C1
          AOD    PC
          LDI    PC
          STD    V
          RJM    HOLL        SECOND CARACTERE
          ADD    C1
          STI    PL
          AOD    PL
          AOD    PC
          SOD    NM
          NJN    MOT
          AOD    NC          UNE CARTE DE PLUS
          LDD    NT
          ADN    LGL
          STD    NT
          LJM    LIRE
*
*         BOUCLE DE RAFRAICHISSEMENT DE LA CONSOLE
*
AFF       FNC    ECRG,CHC
          ACN    CHC
          LDN    TITREL
          OAM    TITRE,CHC
          LDD    NT
          OAM    ZONE,CHC    LIGNES DES CARTES
          DCN    CHC
          UJN    AFF
*
*         HOLL : COLONNE (V) EN HOLLERITH -> A = CARACTERE DISPLAY
*
HOLLX     LJM    *
HOLL      EQU    *-1
          LDN    0
          STD    HUIT
          STD    NL
          LDD    V
          LPC    777B        LIGNES 1 A 9
          STD    D
          ZJN    ZON         PAS DE CHIFFRE
          LMN    2
          ZJN    CHIF        8 SEUL : CHIFFRE ORDINAIRE
          LDD    D
          LPN    2
          ZJN    CHIF        PAS DE PERFORATION 8
          AOD    HUIT        8 COMBINE : CARACTERE SPECIAL
          LDD    D
          LMN    2           RETIRE LA PERFORATION 8
          STD    D
CHIF      LDN    9D
          STD    NL
CHIF1     LDD    D           CHERCHE LE BIT DE LA LIGNE
          LMN    1
          ZJN    ZON
          LDD    D
          SHN    -1
          STD    D
          SOD    NL
          UJN    CHIF1
ZON       LDD    V
          SHN    -9D         LIGNES 12, 11 ET 0
          STD    Z
          LDM    ZIDX,Z      NUMERO DE ZONE 0 A 3
          STD    Z
          LDD    HUIT
          NJN    SPEC
          LDD    Z           INDICE = 10*ZONE + CHIFFRE
          SHN    3
          ADD    Z
          ADD    Z
          ADD    NL
          STD    T1
          LDM    TAB,T1
          LJM    HOLLX
SPEC      LDD    Z           INDICE = 8*ZONE + CHIFFRE
          SHN    3
          ADD    NL
          STD    T1
          LDM    TAB8,T1
          LJM    HOLLX
*
*         TABLES DE CONVERSION (CODE 029)
*
ZIDX      CON    0,3,2,2,1,1,1,1 LIGNES 12/11/0 -> ZONE
TAB       CON    55B,34B,35B,36B,37B,40B,41B,42B,43B,44B SANS ZONE
          CON    67B,1B,2B,3B,4B,5B,6B,7B,10B,11B ZONE 12
          CON    46B,12B,13B,14B,15B,16B,17B,20B,21B,22B ZONE 11
          CON    33B,50B,23B,24B,25B,26B,27B,30B,31B,32B ZONE 0
TAB8      CON    43B,71B,0B,60B,74B,70B,54B,64B SANS ZONE + 8
          CON    10B,71B,61B,57B,72B,51B,45B,66B ZONE 12 + 8
          CON    21B,71B,62B,53B,47B,52B,77B,76B ZONE 11 + 8
          CON    31B,71B,75B,56B,63B,65B,73B,71B ZONE 0 + 8
*
TITRE     CON    6000B+20B,7000B+740B
          DIS    21,LECTEUR DE CARTES 405 - CONTENU DU PAQUET
TITREL    EQU    *-TITRE
CARTE     BSS    80D         CARTE LUE (80 COLONNES)
ZONE      BSS    MAXC*LGL    LIGNES A AFFICHER
          END
