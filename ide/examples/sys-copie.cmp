          IDENT  COPY
          ENTRY  COPY
*         TRAVAIL SOUS LE MINI-SYSTEME (MODE SYSTEME).
*
*         READC LIT LES CARTES DU FICHIER INPUT (LECTEUR 405) ; LA CARTE
*         7/8/9 MARQUE LA FIN DES DONNEES. CHAQUE CARTE EST RECOPIEE SUR
*         OUTPUT (IMPRIMANTE 1612), PUIS LE NOMBRE DE CARTES EST IMPRIME.
*
*         LE PAQUET DE L EXEMPLE EST PLACE DANS LE LECTEUR A L OUVERTURE
*         (ONGLET PERIPHERIQUES > LECTEUR DE CARTES).
*
*         RECOPIE LES CARTES DE INPUT SUR OUTPUT ET COMPTE LES LIGNES.
 COPY     SX6    0
          SA6    COUNT
 COPY1    READC  INPUT,CARD,9
          NZ     X1,COPY2    FIN DES DONNEES
          SA1    COUNT
          SX6    X1+1
          SA6    A1
          WRITEC OUTPUT,LINE
          EQ     COPY1
 COPY2    SA1    COUNT
          CDD
          SA6    NUM
          WRITEC OUTPUT,TOTAL
          WRITER OUTPUT
          MESSAGE DONE
          ENDRUN
 COUNT    DATA   0
 LINE     DATA   1H
 CARD     BSS    9
 TOTAL    DIS    1, CARTES :
 NUM      DATA   0,0
 DONE     DIS    ,*COPIE TERMINEE.*
 INPUT    FILEC  IBUF,101B
 OUTPUT   FILEC  OBUF,101B
 IBUF     BSS    101B
 OBUF     BSS    101B
          END    COPY
